        <mxCell id="MzwgiBffR6clTs4aPWGu-4" parent="MzwgiBffR6clTs4aPWGu-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Latência inaceitável:&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="200" as="geometry">
