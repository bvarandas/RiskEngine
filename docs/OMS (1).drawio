        </object>
        <mxCell id="c9Zo8uok7mfqxX7OydML-5" parent="c9Zo8uok7mfqxX7OydML-1" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedHeader=1;align=left;fontStyle=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Por que o RDS no pré-trade é uma escolha inviável?" vertex="1">
