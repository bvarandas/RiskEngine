        <mxCell id="MzwgiBffR6clTs4aPWGu-5" parent="MzwgiBffR6clTs4aPWGu-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="Consultar e atualizar registros no RDS via rede envolve I/O de disco, concorrência de conexões e custo de parsing SQL. A latência varia de alguns milissegundos (2ms–10ms em rede local) até dezenas de milissegundos. No mercado financeiro, isso é uma eternidade." vertex="1">
          <mxGeometry height="50" width="380" x="200" as="geometry">
            <mxRectangle height="50" width="380" as="alternateBounds" />
          </mxGeometry>
