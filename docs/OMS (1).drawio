        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-6" parent="c9Zo8uok7mfqxX7OydML-5" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" vertex="1">
          <mxGeometry height="50" width="580" y="30" as="geometry" />
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-7" parent="c9Zo8uok7mfqxX7OydML-6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;rowspan=1;colspan=2;" value="A B3 processa ordens em milissegundos e microssegundos. Inserir uma chamada de banco de dados relacional (como PostgreSQL ou MySQL no RDS) para validar e reservar margem no momento em que a ordem entra traz problemas críticos:" vertex="1">
          <mxGeometry height="50" width="580" as="geometry">
            <mxRectangle height="50" width="200" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-8" parent="c9Zo8uok7mfqxX7OydML-6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" vertex="1" visible="0">
          <mxGeometry height="50" width="380" x="200" as="geometry">
            <mxRectangle height="50" width="380" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-9" parent="c9Zo8uok7mfqxX7OydML-5" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" value="" vertex="1">
          <mxGeometry height="50" width="580" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-10" parent="c9Zo8uok7mfqxX7OydML-9" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Latência inaceitável:&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="200" as="geometry">
            <mxRectangle height="50" width="200" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-11" parent="c9Zo8uok7mfqxX7OydML-9" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="Consultar e atualizar registros no RDS via rede envolve I/O de disco, concorrência de conexões e custo de parsing SQL. A latência varia de alguns milissegundos (2ms–10ms em rede local) até dezenas de milissegundos. No mercado financeiro, isso é uma eternidade." vertex="1">
          <mxGeometry height="50" width="380" x="200" as="geometry">
            <mxRectangle height="50" width="380" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-12" parent="c9Zo8uok7mfqxX7OydML-5" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" value="" vertex="1">
          <mxGeometry height="80" width="580" y="130" as="geometry" />
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-13" parent="c9Zo8uok7mfqxX7OydML-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;b&gt;Gargalo de Concorrência (Locking):&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="200" as="geometry">
            <mxRectangle height="80" width="200" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-14" parent="c9Zo8uok7mfqxX7OydML-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="Se múltiplos algoritmos ou clientes tentam consumir o mesmo limite simultaneamente, transações de banco farão &lt;i data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;145&quot;&gt;row locking&lt;/i&gt;. O throughput despenca e a fila de ordens estoura (&lt;i data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;208&quot;&gt;thread starvation&lt;/i&gt;)." vertex="1">
          <mxGeometry height="80" width="380" x="200" as="geometry">
            <mxRectangle height="80" width="380" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-15" parent="c9Zo8uok7mfqxX7OydML-1" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedHeader=1;align=left;fontStyle=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Por que o Cache Distribuído puro tem limitações?" vertex="1">
          <mxGeometry height="210" width="580" x="-560" y="310" as="geometry" />
        </mxCell>
        <mxCell id="c9Zo8uok7mfqxX7OydML-16" parent="c9Zo8uok7mfqxX7OydML-15" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" vertex="1">
          <mxGeometry height="50" width="580" y="30" as="geometry" />
