        <mxCell id="MzwgiBffR6clTs4aPWGu-8" parent="MzwgiBffR6clTs4aPWGu-6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="Se múltiplos algoritmos ou clientes tentam consumir o mesmo limite simultaneamente, transações de banco farão &lt;i data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;145&quot;&gt;row locking&lt;/i&gt;. O throughput despenca e a fila de ordens estoura (&lt;i data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;208&quot;&gt;thread starvation&lt;/i&gt;)." vertex="1">
